{
  "name": "chess-seeker",
  "version": "1.0.0",
  "description": "Offline, private, ad-free chess trainer PWA powered by Stockfish",
  "scripts": {
    "predev": "node scripts/copy-engine.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-engine.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate:lessons": "tsx scripts/validate-lessons.ts",
    "build:puzzles": "node scripts/build-puzzles.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srikads/Chess-Seeker.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/srikads/Chess-Seeker/issues"
  },
  "homepage": "https://github.com/srikads/Chess-Seeker#readme",
  "dependencies": {
    "@lichess-org/chessground": "^10.1.1",
    "chess.js": "^1.4.0",
    "idb": "^8.0.3",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "private": true,
  "type": "module"
}
